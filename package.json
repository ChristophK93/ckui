{
  "name": "ckui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve docs",
    "build:lib": "ng build @ckui/core",
    "build:docs": "ng build docs",
    "lint": "ng lint",
    "test": "ng test @ckui/core --watch=false && ng test docs --watch=false",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "check": "npm run format:check && npm run lint && npm run test && npm run build:lib && npm run build:docs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build:lib && npm publish ./dist/ckui/core && changeset git-tag"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@vitest/browser-playwright": "^5.1.0",
    "angular-eslint": "22.6.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "ng-packagr": "^22.2.6",
    "playwright": "^1.64.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "projects/core"
  ]
}
